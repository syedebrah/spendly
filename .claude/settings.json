{
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(python *)",
      "Bash(pytest *)",
      "Bash(pip *)",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep"
    ]
  },
  "env": {
    "FLASK_ENV": "development",
    "FLASK_DEBUG": "1"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // .tool_response.filePath' | { read -r f; if [[ \"$f\" == *.py ]]; then black \"$f\" 2>/dev/null || true; fi; }",
            "statusMessage": "Formatting Python with Black...",
            "if": "Write|Edit(.+\\.py$)"
          },
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // .tool_response.filePath' | { read -r f; if [[ \"$f\" == *.css || \"$f\" == *.js ]]; then npx prettier --write \"$f\" 2>/dev/null || true; fi; }",
            "statusMessage": "Formatting with Prettier...",
            "if": "Write|Edit(.+\\.(css|js)$)"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "deploy|push to|commit",
        "hooks": [
          {
            "type": "command",
            "command": "cd F:\\expense-tracker && pytest -v 2>&1 | head -50",
            "statusMessage": "Running pre-deployment tests...",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
